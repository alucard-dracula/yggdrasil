<?xml version="1.0" encoding="utf-8"?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6"/>
	<Project>
		<Option title="LzmaLib_static"/>
		<Option pch_mode="2"/>
		<Option compiler="gcc"/>
		<Build>
			<Target title="Debug-Win32">
				<Option output="$(WORKSPACE_DIR)/lib/liblzma_static$(#COMPILER_VERSION_TAG)-d" prefix_auto="1" extension_auto="1"/>
				<Option object_output="$(TARGET_NAME)/$(PROJECT_NAME)$(#COMPILER_VERSION_TAG)"/>
				<Option type="2"/>
				<Option compiler="gnu_gcc32_compiler"/>
				<Option createDefFile="1"/>
				<Option projectLinkerOptionsRelation="2"/>
				<Compiler>
					<Add option="-m32"/>
					<Add option="-O0"/>
					<Add option="-g"/>
					<Add option="-DCOMPRESS_MF_MT"/>
					<Add option="-D_DEBUG"/>
				</Compiler>
				<Linker>
					<Add option="-m32"/>
				</Linker>
			</Target>
			<Target title="Release-Win32">
				<Option output="$(WORKSPACE_DIR)/lib/liblzma_static$(#COMPILER_VERSION_TAG)" prefix_auto="1" extension_auto="1"/>
				<Option object_output="$(TARGET_NAME)/$(PROJECT_NAME)$(#COMPILER_VERSION_TAG)"/>
				<Option type="2"/>
				<Option compiler="gnu_gcc32_compiler"/>
				<Option createDefFile="1"/>
				<Option projectLinkerOptionsRelation="2"/>
				<Compiler>
					<Add option="-m32"/>
					<Add option="-O3"/>
					<Add option="-DNDEBUG"/>
				</Compiler>
				<Linker>
					<Add option="-m32"/>
					<Add option="-s"/>
				</Linker>
			</Target>
			<Target title="Debug-x64">
				<Option output="$(WORKSPACE_DIR)/lib64/liblzma_static$(#COMPILER_VERSION_TAG)-d" prefix_auto="1" extension_auto="1"/>
				<Option object_output="$(TARGET_NAME)/$(PROJECT_NAME)$(#COMPILER_VERSION_TAG)"/>
				<Option type="2"/>
				<Option compiler="gcc"/>
				<Option createDefFile="1"/>
				<Option projectLinkerOptionsRelation="2"/>
				<Compiler>
					<Add option="-m64"/>
					<Add option="-O0"/>
					<Add option="-g"/>
					<Add option="-DCOMPRESS_MF_MT"/>
					<Add option="-DWIN64"/>
					<Add option="-D_DEBUG"/>
				</Compiler>
				<Linker>
					<Add option="-m64"/>
				</Linker>
			</Target>
			<Target title="Release-x64">
				<Option output="$(WORKSPACE_DIR)/lib64/liblzma_static$(#COMPILER_VERSION_TAG)" prefix_auto="1" extension_auto="1"/>
				<Option object_output="$(TARGET_NAME)/$(PROJECT_NAME)$(#COMPILER_VERSION_TAG)"/>
				<Option type="2"/>
				<Option compiler="gcc"/>
				<Option createDefFile="1"/>
				<Option projectLinkerOptionsRelation="2"/>
				<Compiler>
					<Add option="-m64"/>
					<Add option="-O3"/>
					<Add option="-DNDEBUG"/>
					<Add option="-DWIN64"/>
				</Compiler>
				<Linker>
					<Add option="-m64"/>
					<Add option="-s"/>
				</Linker>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="all" targets="Debug-Win32;Release-Win32;Debug-x64;Release-x64;"/>
			<Add alias="all_libonly" targets="Debug-Win32;Release-Win32;Debug-x64;Release-x64;"/>
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall"/>
			<Add option="-std=c++17"/>
			<Add option="-fexceptions"/>
			<Add option="-Wno-sign-compare"/>
			<Add option="-Wno-comment"/>
			<Add option="-Wno-enum-compare"/>
			<Add option="-Wno-unused-local-typedefs"/>
			<Add option="-Wno-multichar"/>
			<Add option="-Werror=return-type"/>
			<Add option="-Werror=endif-labels"/>
			<Add option="-fdata-sections"/>
			<Add option="-ffunction-sections"/>
			<Add option="-fno-strict-aliasing"/>
			<Add option="-DWIN32"/>
			<Add option="-D_LIB"/>
		</Compiler>
		<Unit filename="../../7zTypes.h"/>
		<Unit filename="../../7zWindows.h"/>
		<Unit filename="../../Alloc.c"/>
		<Unit filename="../../Alloc.h"/>
		<Unit filename="../../Compiler.h"/>
		<Unit filename="../../CpuArch.c"/>
		<Unit filename="../../CpuArch.h"/>
		<Unit filename="../../LzFind.c"/>
		<Unit filename="../../LzFind.h"/>
		<Unit filename="../../LzFindMt.c"/>
		<Unit filename="../../LzFindMt.h"/>
		<Unit filename="../../LzFindOpt.c"/>
		<Unit filename="../../LzHash.h"/>
		<Unit filename="../../LzmaDec.c"/>
		<Unit filename="../../LzmaDec.h"/>
		<Unit filename="../../LzmaEnc.c"/>
		<Unit filename="../../LzmaEnc.h"/>
		<Unit filename="../../LzmaLib.c"/>
		<Unit filename="../../LzmaLib.h"/>
		<Unit filename="../../Precomp.h"/>
		<Unit filename="../../Threads.c"/>
		<Unit filename="../../Threads.h"/>
		<Unit filename="Precomp.h"/>
		<Extensions>
			<lib_finder disable_auto="1"/>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
